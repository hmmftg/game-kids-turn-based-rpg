{
  "name": "mahalle-ye-mehrabani",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "«محله‌ی مهربانی» — offline-first Persian RTL turn-based RPG vertical slice for ages 3-7.",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run validate:content && tsc -b && vite build && npm run check:budgets",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -b --force",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "validate:content": "node --experimental-strip-types scripts/validate-content.ts",
    "validate:content:release": "node --experimental-strip-types scripts/validate-content.ts --release",
    "check:budgets": "node --experimental-strip-types scripts/check-budgets.ts",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.186.0",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "fake-indexeddb": "6.2.5",
    "globals": "17.12.0",
    "jsdom": "30.1.0",
    "prettier": "3.9.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vazirmatn": "33.0.3",
    "vite": "8.3.0",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.11"
  }
}
